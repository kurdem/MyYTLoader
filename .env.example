# ---------------------------------------------------------------- Basis
# Port im Container und auf dem Host
APP_PORT=8080
# Öffentliche Adresse (z. B. hinter Nginx Proxy Manager). Wichtig für den Podcast-Feed.
# Leer = wird aus der Anfrage abgeleitet.
BASE_URL=
# Benutzer-/Gruppen-ID, unter der die App läuft (Eigentümer der Dateien auf dem Host)
PUID=1000
PGID=1000
# Ablage der fertigen Dateien auf dem Docker-Host (Standard: ./data/downloads)
HOST_DOWNLOAD_PATH=./data/downloads
LOG_LEVEL=INFO

# ------------------------------------------------- Pfade im Container (i. d. R. nicht ändern)
DOWNLOAD_PATH=/downloads
TEMP_PATH=/temp

# ---------------------------------------------------------------- Anmeldung & Benutzer
AUTH_ENABLED=true
# Erster Admin – wird nur beim allerersten Start angelegt. Weitere Benutzer in der Oberfläche (Mehr → Benutzer).
ADMIN_USERNAME=admin
# Leer = Passwort wird beim ersten Start erzeugt (Log + /config/admin_password.txt)
ADMIN_PASSWORD=
# true = setzt beim Start das Passwort von ADMIN_USERNAME auf ADMIN_PASSWORD (Notfall), danach wieder false setzen
ADMIN_PASSWORD_RESET=false
# Vorgaben für neue Benutzer (0 = unbegrenzt), pro Benutzer änderbar
DEFAULT_USER_QUOTA_MB=0
DEFAULT_USER_MAX_JOBS=0
# Leer = wird automatisch erzeugt und in /config/secret.key gespeichert
SECRET_KEY=
SESSION_MAX_AGE_DAYS=30

# ---------------------------------------------------------------- Downloads
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE_MB=2048
PLAYLIST_MAX_ITEMS=200
# Kommagetrennt, Subdomains sind eingeschlossen
ALLOWED_DOMAINS=youtube.com,youtu.be,youtube-nocookie.com
# Anfragen pro Minute und Client für Analyse/Download/Upload
RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------- Audio-Standards
DEFAULT_AUDIO_FORMAT=m4a
DEFAULT_AUDIO_BITRATE=192k
DEFAULT_NORMALIZE=true
DEFAULT_TRIM_SILENCE=false
# Originaldatei zusätzlich behalten (Standard für neue Aufträge)
KEEP_ORIGINAL=false

# ---------------------------------------------------------------- Wartung
# Temporäre Dateien nach X Stunden entfernen
TEMP_MAX_AGE_HOURS=12
# Medien automatisch nach X Tagen löschen (0 = nie)
RETENTION_DAYS=0

# ---------------------------------------------------------------- yt-dlp
# Täglich und beim Start automatisch aktualisieren (benötigt Internetzugang zu PyPI)
YTDLP_AUTO_UPDATE=true
# stable oder nightly
YTDLP_CHANNEL=stable
# Pause (Sekunden) zwischen Playlist-Einträgen, schont das Rate-Limit von YouTube
YTDLP_SLEEP_INTERVAL=3

# ---------------------------------------------------------------- Reverse Proxy
# Proxies, deren X-Forwarded-*-Header vertraut wird (* = alle; bei direktem Zugriff ggf. einschränken)
FORWARDED_ALLOW_IPS=*
